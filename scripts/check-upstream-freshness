#!/bin/sh
# check-upstream-freshness - is each vendored skill still current with its
# canonical upstream? Compares the stamped "Source commit" in each vendored
# SKILL.md header against the upstream repo's latest default-branch commit.
# When upstream has moved, it asks GitHub which files changed since the stamp
# and reports a re-sync as due only if a commit touched SKILL.md or a
# references/ file, the paths voiceprint vendors. Commits that change only an
# upstream's CI, README, or other tooling are reported as content current.
# Read-only: it changes nothing.
#
# The vendored tree under vendor/ is a synced copy, and nothing else forces a
# re-pull when an upstream advances. That gap once let the vendored copies fall
# a full version behind. This is the standing guard for the sync obligation.
# Run it on a schedule (.github/workflows/upstream-freshness.yml) or by hand.
#
# Requires: the gh CLI, authenticated, or GH_TOKEN in the environment (as in
# CI). It reads only public repository metadata through the GitHub API.
#
# Exit status:
#   0  every vendored skill is current (its vendored paths are unchanged)
#   1  at least one has a vendored path changed upstream (re-sync due)
#   2  could not check (missing gh, unreadable header, API/network error),
#      kept distinct from 1 so "stale" never hides behind "unknown".

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# vendored-dir : owner/repo : default-branch  (the canonical upstream per skill).
# The shared detection criteria are canonical in humanizer, so the humanizer row
# already covers their freshness; only the two skill roots need listing.
SKILLS='humanizer:hannsxpeter/humanizer:main authenticity-check:hannsxpeter/authenticity-check:main'

command -v gh >/dev/null 2>&1 || {
  printf 'check-upstream-freshness: gh CLI not found (or set GH_TOKEN in CI).\n' >&2
  exit 2
}

# Append a line to the GitHub Actions job summary when running in CI; no-op locally.
gha() { [ -n "${GITHUB_STEP_SUMMARY:-}" ] && printf '%s\n' "$1" >> "$GITHUB_STEP_SUMMARY" || true; }

gha "## Upstream freshness"

stale=0
err=0

for entry in $SKILLS; do
  dir=${entry%%:*}; rest=${entry#*:}; repo=${rest%%:*}; branch=${rest#*:}
  hdr="$ROOT/vendor/$dir/SKILL.md"

  if [ ! -f "$hdr" ]; then
    printf 'ERROR %s: no vendored SKILL.md (%s)\n' "$dir" "$hdr" >&2
    gha "- \`$dir\`: error (no vendored SKILL.md)"; err=1; continue
  fi

  stamped=$(sed -n 's/^Source commit: \([0-9a-f][0-9a-f]*\).*/\1/p' "$hdr" | head -n1)
  if [ -z "$stamped" ]; then
    printf 'ERROR %s: no "Source commit:" line in header\n' "$dir" >&2
    gha "- \`$dir\`: error (no Source commit in header)"; err=1; continue
  fi

  latest=$(gh api "repos/$repo/commits/$branch" --jq '.sha' 2>/dev/null || true)
  if [ -z "$latest" ]; then
    printf 'ERROR %s: could not read %s@%s (auth/network?)\n' "$dir" "$repo" "$branch" >&2
    gha "- \`$dir\`: error (could not reach $repo)"; err=1; continue
  fi

  s7=$(printf '%s' "$stamped" | cut -c1-7)
  l7=$(printf '%s' "$latest" | cut -c1-7)

  if [ "$stamped" = "$latest" ]; then
    printf 'OK    %-20s current with %s@%s (%s)\n' "$dir" "$repo" "$branch" "$s7"
    gha "- \`$dir\`: current (\`$s7\`)"
  else
    # Upstream moved. It matters only if a commit since the stamp changed a
    # vendored path, which the compare API can answer only when the stamp is an
    # ancestor of the branch (status "ahead"); any other status is stale. A file
    # list of 300 or more may be truncated, so it counts as a change, and a
    # rename out of a vendored path counts through its previous name.
    summary=$(gh api "repos/$repo/compare/$stamped...$latest" --jq '
      "\(.status)|\(.ahead_by // "?")|" + (if ((.files // []) | length) >= 300 then "many files"
        else ([(.files // [])[] | (.filename, (.previous_filename // empty))
               | select(. == "SKILL.md" or startswith("references/"))] | unique | join(", "))
        end)' 2>/dev/null || true)
    if [ -z "$summary" ]; then
      printf 'ERROR %s: could not compare %s with %s@%s (auth/network?)\n' "$dir" "$s7" "$repo" "$branch" >&2
      gha "- \`$dir\`: error (could not compare with $repo)"; err=1; continue
    fi
    compare_status=${summary%%|*}
    rest=${summary#*|}
    behind=${rest%%|*}
    touched=${rest#*|}
    if [ "$compare_status" != "ahead" ]; then
      printf 'STALE %-20s %s is not an ancestor of %s@%s (%s; compare status %s); re-sync from the default branch\n' \
        "$dir" "$s7" "$repo" "$branch" "$l7" "$compare_status"
      gha "- \`$dir\`: **re-sync due**: vendored \`$s7\` is not an ancestor of $branch (\`$l7\`, status $compare_status)"
      stale=1
    elif [ -z "$touched" ]; then
      printf 'OK    %-20s content current: %s@%s (%s) is %s commit(s) past %s, none touching SKILL.md or references/\n' \
        "$dir" "$repo" "$branch" "$l7" "$behind" "$s7"
      gha "- \`$dir\`: content current (vendored \`$s7\`; $behind newer upstream commit(s) change no vendored path)"
    else
      rel=$(gh api "repos/$repo/releases/latest" --jq '.tag_name' 2>/dev/null || printf '')
      printf 'STALE %-20s %s is %s commit(s) behind %s@%s (%s), changing %s%s\n' \
        "$dir" "$s7" "$behind" "$repo" "$branch" "$l7" "$touched" "${rel:+; latest release $rel}"
      gha "- \`$dir\`: **re-sync due**: $behind commit(s) behind (vendored \`$s7\`, latest \`$l7\`), changing $touched${rel:+; release $rel}"
      stale=1
    fi
  fi
done

if [ "$err" -eq 1 ]; then
  gha ""
  gha "Could not fully check; see the run log."
  printf 'check-upstream-freshness: incomplete (errors above).\n' >&2
  exit 2
fi

if [ "$stale" -eq 1 ]; then
  gha ""
  gha "Re-sync due: run \`scripts/sync-upstream\`, then \`scripts/check-vendor-headers\`, then commit \`vendor/\`."
  printf 'check-upstream-freshness: re-sync due (run scripts/sync-upstream).\n'
  exit 1
fi

printf 'check-upstream-freshness: all vendored skills current.\n'
exit 0
